{
  "id": "test-workflow-002",
  "name": "Conditional Disk Space Check",
  "description": "Test workflow with a condition branch that checks disk space and notifies only if usage is high",
  "version": "1.0",
  "nodes": [
    {
      "id": "trigger-1",
      "node_type": "trigger",
      "name": "Manual Trigger",
      "position": { "x": 100, "y": 200 },
      "config": {
        "type": "trigger",
        "trigger_type": { "type": "manual" }
      }
    },
    {
      "id": "action-1",
      "node_type": "action",
      "name": "Check Disk Usage",
      "position": { "x": 350, "y": 200 },
      "config": {
        "type": "action",
        "action_type": {
          "type": "ssh_command",
          "host": "localhost",
          "port": 22,
          "username": "admin",
          "password": null,
          "command": "df -h / | tail -1 | awk '{print $5}' | sed 's/%//'"
        }
      }
    },
    {
      "id": "condition-1",
      "node_type": "condition",
      "name": "High Usage?",
      "position": { "x": 600, "y": 200 },
      "config": {
        "type": "condition",
        "expression": "parseInt(last_ssh_output) > 80",
        "true_branch": "notification-high",
        "false_branch": "notification-ok"
      }
    },
    {
      "id": "notification-high",
      "node_type": "notification",
      "name": "High Usage Alert",
      "position": { "x": 850, "y": 150 },
      "config": {
        "type": "notification",
        "title": "Disk Usage Alert",
        "message": "Warning: Disk usage is above 80%",
        "channel": "both"
      }
    },
    {
      "id": "notification-ok",
      "node_type": "notification",
      "name": "Disk OK",
      "position": { "x": 850, "y": 250 },
      "config": {
        "type": "notification",
        "title": "Disk Check Passed",
        "message": "Disk usage is within normal limits",
        "channel": "in_app"
      }
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "source": "trigger-1",
      "target": "action-1"
    },
    {
      "id": "conn-2",
      "source": "action-1",
      "target": "condition-1"
    },
    {
      "id": "conn-3",
      "source": "condition-1",
      "target": "notification-high",
      "sourcePort": "true"
    },
    {
      "id": "conn-4",
      "source": "condition-1",
      "target": "notification-ok",
      "sourcePort": "false"
    }
  ],
  "created_at": "2026-02-01T00:00:00Z",
  "updated_at": "2026-02-01T00:00:00Z"
}
