{
  "id": "test-workflow-001",
  "name": "Basic Server Health Check",
  "description": "A simple test workflow that checks server uptime and sends a notification with results",
  "version": "1.0",
  "nodes": [
    {
      "id": "trigger-1",
      "node_type": "trigger",
      "name": "Manual Trigger",
      "position": { "x": 100, "y": 200 },
      "config": {
        "type": "trigger",
        "trigger_type": { "type": "manual" }
      }
    },
    {
      "id": "action-1",
      "node_type": "action",
      "name": "Check Uptime",
      "position": { "x": 350, "y": 200 },
      "config": {
        "type": "action",
        "action_type": {
          "type": "ssh_command",
          "host": "localhost",
          "port": 22,
          "username": "admin",
          "password": null,
          "command": "uptime"
        }
      }
    },
    {
      "id": "notification-1",
      "node_type": "notification",
      "name": "Notify Result",
      "position": { "x": 600, "y": 200 },
      "config": {
        "type": "notification",
        "title": "Server Check Complete",
        "message": "Health check finished. Check execution history for results.",
        "channel": "in_app"
      }
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "source": "trigger-1",
      "target": "action-1"
    },
    {
      "id": "conn-2",
      "source": "action-1",
      "target": "notification-1"
    }
  ],
  "created_at": "2026-02-01T00:00:00Z",
  "updated_at": "2026-02-01T00:00:00Z"
}
