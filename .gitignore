# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vs/

# Rust / Cargo build output (do not commit)
**/target/
src-tauri/src-tauri/

# SQLite temporary files (test runs, etc.) — do not commit
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Personal Claude Code settings (per-machine permission allowlists) — never commit
.claude/settings.local.json

# Secrets: updater signing keys, env files
*.key
*.key.pub
.env
.env.*

# Test coverage output
coverage/
audit/coverage-fe/*
!audit/coverage-fe/coverage-summary.json
audit/coverage-rs/

# OS junk
Thumbs.db
desktop.ini
